{
  "name": "vibe-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "npx wrangler deploy",
    "deploy:preview": "npx wrangler deploy --config wrangler.preview.jsonc",
    "deploy:preview:prepare-transfer": "npx wrangler deploy --config wrangler.preview.transfer-target.jsonc",
    "deploy:legacy-preview:transfer": "npx wrangler deploy --config wrangler.preview.transfer-source.jsonc",
    "start": "next start",
    "lint": "next lint",
    "db:migrate:local": "node scripts/wrangler-d1.mjs d1 migrations apply app_builder --local",
    "db:migrate:remote": "node scripts/wrangler-d1.mjs d1 migrations apply app_builder --remote"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
