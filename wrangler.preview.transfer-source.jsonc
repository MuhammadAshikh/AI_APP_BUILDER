{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-builder",
  "main": "preview-worker/index.ts",
  "compatibility_date": "2025-11-17",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "exports": {
    "PreviewContainer": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "app-builder-preview"
    }
  },
  "d1_databases": [
    {
      "binding": "PROJECTS_DB",
      "database_name": "app_builder",
      "database_id": "5dcd66c2-526b-4a54-886e-56108fbc9b39"
    }
  ]
}
