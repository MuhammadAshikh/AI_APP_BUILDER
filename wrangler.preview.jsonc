{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-builder-preview",
  "main": "preview-worker/index.ts",
  "compatibility_date": "2025-11-17",
  "routes": [
    {
      "pattern": "*.hamshake.com/*",
      "zone_name": "hamshake.com"
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "PreviewContainer",
      "scheduling_policy": "durable_object",
      "max_instances": 20,
      "images": {
        "base": {
          "dockerfile": "./preview-worker/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PREVIEW_CONTAINERS",
        "class_name": "PreviewContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PreviewContainer"]
    }
  ],
  "exports": {
    "PreviewContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "PROJECTS_DB",
      "database_name": "app_builder",
      "database_id": "5dcd66c2-526b-4a54-886e-56108fbc9b39"
    }
  ]
}
